# Resend API Key - Get this from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Your email address where you want to receive contact form submissions.
# NOTE: while RESEND_FROM is unset (Resend sandbox), this MUST be the email
# address your Resend account is registered with.
CONTACT_EMAIL=stefan.vranjes995@outlook.com

# Sender address. Leave unset to use Resend's sandbox (onboarding@resend.dev),
# which can only deliver to your own Resend account address. Once you verify
# stefanwebdev.com at resend.com/domains, set it to an address on that domain
# and CONTACT_EMAIL can be anything.
# RESEND_FROM=Contact Form <contact@stefanwebdev.com>

# Your website URL (for SEO and metadata)
NEXT_PUBLIC_SITE_URL=https://stefanwebdev.com

# Google Search Console verification code (Settings -> Ownership verification
# -> HTML tag; copy only the content="..." value). Leave unset until you have it.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Your X/Twitter handle including the @, only if you actually have one.
NEXT_PUBLIC_TWITTER_HANDLE= 